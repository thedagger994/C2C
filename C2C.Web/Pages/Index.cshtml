@page
@model IndexModel
@{
    ViewData["Title"] = "Civil Engineering, Quality Verification & Testing";
}

<section class="hero">
    @Img.Tag("bridge-deck", "Reinforcing steel on a bridge deck ready for a concrete pour", "100vw", null, true)
    <div class="wrap">
        <p class="tag">Don't just build... create.</p>
        <h1>Crafting Tomorrow's Solutions Today.</h1>
        <p class="lede">Experienced &amp; Reliable Engineers, for over 20 years.</p>
        <div class="btn-row">
            <a class="btn" href="/get-a-quote#quote">Get a Quote</a>
            <a class="btn btn-ghost" href="/services">Our Services</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap split">
        <div class="reveal">
            <p class="eyebrow">Who We Are</p>
            <h2>We provide professional solutions to deliver safe &amp; efficient projects</h2>
            <p class="lead">C2C Lead Engineering provides a comprehensive spectrum of civil services, encompassing design and consulting expertise tailored to the diverse needs of the infrastructure, buildings and construction industry.</p>
            <div class="btn-row"><a class="btn" href="/about-us">About Us</a></div>
        </div>
        <div class="photo tall reveal">@Img.Tag("rebar-crew", "Crew placing reinforcing steel on a high-rise structure", "(max-width: 960px) 100vw, 45vw")</div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="center reveal">
            <p class="eyebrow">What We Do</p>
            <h2>Services Offered</h2>
            <p class="lead">Quality is Our Priority.</p>
        </div>
        <ul class="chip-grid reveal">
            <li>Foundation design</li>
            <li>Soil Investigation</li>
            <li>Shoring systems design</li>
            <li>Mobile cranes and drilling pads</li>
            <li>H-Piles and caisson foundations</li>
            <li>Excavation base and structural backfill (frost taper)</li>
            <li>Bridge bearings and expansion joints</li>
            <li>Documents review</li>
            <li>Quality management plan (CQMP) assessment</li>
            <li>Granular and compaction testing</li>
            <li>Concrete material testing</li>
            <li>Fresh concrete testing and compressive tests</li>
        </ul>
        <div class="center reveal"><div class="btn-row center-row" ><a class="btn" href="/services">See All Services</a></div></div>
    </div>
</section>

<section class="cta-band">
    <div class="wrap reveal">
        <h2>Looking to get a quote from us?</h2>
        <p>Tell us about your project and we'll get back to you with an estimate.</p>
        <div class="btn-row center-row" ><a class="btn btn-ghost" href="/get-a-quote#quote">Request a Quote</a></div>
    </div>
</section>
