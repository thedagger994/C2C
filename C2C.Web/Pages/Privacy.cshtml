@page "/privacy"
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}
<section class="section">
    <div class="wrap prose">
        <h1>Privacy</h1>
        <p>Coast 2 Coast Lead Engineering Inc. collects only the information you submit through our quote and "Work With Us" forms (name, company, email, phone, project details and any file you attach). We use it solely to respond to your inquiry or evaluate your submission and do not sell or share it with third parties.</p>
        <p>Submissions are stored securely and kept only as long as needed for that purpose. To request access to or deletion of your information, email <a href="mailto:info@c2cleadengineering.ca">info@c2cleadengineering.ca</a>.</p>
        <p>This site loads fonts from Google Fonts. We do not use advertising or analytics trackers.</p>
    </div>
</section>
